{
  "table": "fact_condenser_metrics_hourly",
  "layer": "gold",
  "grain": "one row per condenser per hour",
  "partitionBy": ["date"],
  "columns": [
    { "name": "date", "type": "string", "key": "FK -> dim_date" },
    { "name": "hour", "type": "int64", "note": "0-23" },
    { "name": "location_id", "type": "string", "key": "FK -> dim_location" },
    { "name": "hvac_machine_id", "type": "string", "key": "FK -> dim_hvac_machine" },
    { "name": "component_id", "type": "string", "key": "FK -> dim_component" },
    { "name": "avg_water_inlet_temperature_c", "type": "double" },
    { "name": "avg_water_outlet_temperature_c", "type": "double" },
    { "name": "avg_fan_speed_rpm", "type": "double" },
    { "name": "avg_heat_rejection_efficiency_pct", "type": "double" },
    { "name": "avg_approach_temperature_c", "type": "double" }
  ]
}
