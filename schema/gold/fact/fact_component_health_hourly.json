{
  "table": "fact_component_health_hourly",
  "layer": "gold",
  "grain": "one row per component per hour",
  "partitionBy": ["date"],
  "note": "Hourly granularity health monitoring for intraday dashboard views",
  "columns": [
    { "name": "date", "type": "string", "key": "FK -> dim_date" },
    { "name": "hour", "type": "int64", "note": "0-23, hour of day" },
    { "name": "location_id", "type": "string", "key": "FK -> dim_location" },
    { "name": "hvac_machine_id", "type": "string", "key": "FK -> dim_hvac_machine" },
    { "name": "component_id", "type": "string", "key": "FK -> dim_component" },
    { "name": "component_type", "type": "string", "note": "Denormalized: compressor | condenser | evaporator | expansion_valve" },
    { "name": "total_readings", "type": "int64", "note": "Readings in that hour (12 = full hour at 5-min intervals)" },
    { "name": "critical_readings", "type": "int64" },
    { "name": "warning_readings", "type": "int64" },
    { "name": "critical_reading_code", "type": "int64", "note": "Numeric fault code. 0 = no fault." },
    { "name": "health_score_pct", "type": "double", "note": "0-100% health score for that hour" }
  ]
}
