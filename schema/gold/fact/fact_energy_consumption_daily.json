{
  "table": "fact_energy_consumption_daily",
  "layer": "gold",
  "grain": "one row per component per day",
  "partitionBy": ["date"],
  "columns": [
    { "name": "date", "type": "string", "key": "FK -> dim_date" },
    { "name": "location_id", "type": "string", "key": "FK -> dim_location" },
    { "name": "hvac_machine_id", "type": "string", "key": "FK -> dim_hvac_machine" },
    { "name": "component_id", "type": "string", "key": "FK -> dim_component" },
    { "name": "component_type", "type": "string" },
    { "name": "avg_power_kw", "type": "double", "note": "Average power consumption that day" },
    { "name": "max_power_kw", "type": "double", "note": "Peak power consumption" },
    { "name": "min_power_kw", "type": "double", "note": "Minimum power consumption" },
    { "name": "total_readings", "type": "int64", "note": "Number of readings used in calculation" },
    { "name": "daily_energy_kwh", "type": "double", "note": "Total energy consumed (kWh). Calculated as avg_power_kw * total_readings * (5/60)" }
  ]
}
