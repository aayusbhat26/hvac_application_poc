{
  "table": "fact_maintenance_history",
  "layer": "gold",
  "grain": "one row per maintenance work order",
  "columns": [
    { "name": "maintenance_id", "type": "string", "key": "PK" },
    { "name": "component_key", "type": "bigint", "key": "FK -> dim_component" },
    { "name": "hvac_machine_key", "type": "bigint", "key": "FK -> dim_hvac_machine" },
    { "name": "location_key", "type": "bigint", "key": "FK -> dim_location" },
    { "name": "company_key", "type": "bigint", "key": "FK -> dim_company (denormalized)" },
    { "name": "maintenance_date", "type": "date", "note": "Scheduled date of work" },
    { "name": "maintenance_type", "type": "string", "note": "SCHEDULED | CORRECTIVE | PREDICTIVE" },
    { "name": "maintenance_category", "type": "string", "note": "Preventive | Corrective — high-level category shown in UI" },
    { "name": "status", "type": "string", "note": "SCHEDULED | IN_PROGRESS | COMPLETED | OVERDUE | CANCELLED" },
    { "name": "priority", "type": "string", "note": "critical | medium | low" },
    { "name": "description", "type": "string", "note": "Human-readable, e.g. 'Compressor oil change and bearing inspection'" },
    { "name": "assigned_technician", "type": "string", "note": "Name shown in Maintenance Schedule list" },
    { "name": "performed_by", "type": "string" },
    { "name": "notes", "type": "string" },
    { "name": "sla_target_date", "type": "date", "note": "Deadline for SLA compliance tracking", "nullable": true },
    { "name": "actual_completion_date", "type": "date", "nullable": true },
    { "name": "technician_hours", "type": "double", "nullable": true, "note": "For Maintenance Report — technician hour rollups" },
    { "name": "next_maintenance_due", "type": "date" }
  ]
}