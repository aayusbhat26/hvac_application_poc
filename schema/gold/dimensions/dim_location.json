{
  "table": "dim_location",
  "layer": "gold",
  "grain": "one row per location",
  "source": "config/topology/locations.json",
  "columns": [
    { "name": "location_id", "type": "string", "key": "PK (natural key)", "note": "e.g. LOC-01" },
    { "name": "company_id", "type": "string", "key": "FK -> dim_company" },
    { "name": "location_name", "type": "string", "note": "e.g. Marriott Downtown NYC" },
    { "name": "city", "type": "string", "note": "e.g. New York, Chicago, Dubai" },
    { "name": "state", "type": "string", "note": "e.g. NY, IL, TX" },
    { "name": "country", "type": "string", "note": "e.g. USA, UAE" }
  ]
}