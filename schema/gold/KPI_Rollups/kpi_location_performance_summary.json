{
  "table": "kpi_location_performance_summary",
  "layer": "gold",
  "grain": "one row per location per day",
  "partitionBy": ["date"],
  "columns": [
    { "name": "date", "type": "string", "key": "FK -> dim_date" },
    { "name": "location_id", "type": "string", "key": "FK -> dim_location" },
    { "name": "avg_health_score", "type": "double" },
    { "name": "machines_count", "type": "int64" },
    { "name": "total_fault_events", "type": "int64" },
    { "name": "avg_location_cop", "type": "double" }
  ]
}
