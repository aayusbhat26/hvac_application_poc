{
  "table": "kpi_location_energy_daily",
  "layer": "gold",
  "grain": "one row per location per day",
  "partitionBy": ["date"],
  "columns": [
    { "name": "date", "type": "string", "key": "FK -> dim_date" },
    { "name": "location_id", "type": "string", "key": "FK -> dim_location" },
    { "name": "total_power_consumption_kwh", "type": "double" },
    { "name": "compressor_power_kwh", "type": "double" },
    { "name": "condenser_fan_power_kwh", "type": "double" },
    { "name": "pump_power_kwh", "type": "double", "note": "Evaporator pump power" },
    { "name": "valve_power_kwh", "type": "double", "note": "Expansion valve power" }
  ]
}
