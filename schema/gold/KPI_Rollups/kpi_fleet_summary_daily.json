{
  "table": "kpi_fleet_summary_daily",
  "layer": "gold",
  "grain": "one row per day for the entire fleet",
  "partitionBy": ["date"],
  "columns": [
    { "name": "date", "type": "string", "key": "FK -> dim_date" },
    { "name": "total_locations", "type": "int64" },
    { "name": "total_machines", "type": "int64" },
    { "name": "machines_online", "type": "int64" },
    { "name": "healthy_count", "type": "int64" },
    { "name": "warning_count", "type": "int64" },
    { "name": "critical_count", "type": "int64" },
    { "name": "avg_health_score", "type": "double" },
    { "name": "total_energy_kwh", "type": "double" },
    { "name": "avg_cop", "type": "double" },
    { "name": "active_fault_count", "type": "int64" }
  ]
}
