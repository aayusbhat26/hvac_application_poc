    { "name": "condenser_fan_power_kwh", "type": "double" },
    { "name": "pump_power_kwh", "type": "double" },
    { "name": "estimated_energy_cost", "type": "double", "nullable": true },
    { "name": "carbon_estimate_kg", "type": "double", "nullable": true }
  ]
}