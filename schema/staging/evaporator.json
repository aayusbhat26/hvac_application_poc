{
  "table": "stg_evaporator",
  "layer": "staging",
  "partitionBy": ["date"],
  "columns": [
    { "name": "event_id", "type": "string", "key": "PK" },
    { "name": "timestamp", "type": "int64", "note": "Unix timestamp in milliseconds" },
    { "name": "evaporator_status", "type": "string" },
    { "name": "flow_switch_status", "type": "string" },
    { "name": "pump_control_mode", "type": "string" },
    { "name": "pump_relay1_status", "type": "string" },
    { "name": "pump_relay2_status", "type": "string" },
    { "name": "run_hours", "type": "string" },
    { "name": "entering_chilled_water_temperature_c", "type": "string" },
    { "name": "leaving_chilled_water_temperature_c", "type": "string" },
    { "name": "temperature_difference_c", "type": "string" },
    { "name": "evaporator_pressure_kpa", "type": "string" },
    { "name": "water_flow_rate_gpm", "type": "string" },
    { "name": "lwt_setpoint_c", "type": "string" },
    { "name": "pump_power_consumption_kw", "type": "string" },
    { "name": "pump_current_a", "type": "string" },
    { "name": "pump_frequency_hz", "type": "string" },
    { "name": "cooling_capacity_tr", "type": "string" },
    { "name": "heat_transfer_efficiency_pct", "type": "string" },
    { "name": "water_flow_rate_lpm", "type": "string" },
    { "name": "health_active_fault_code", "type": "float64" },
    { "name": "health_maintenance_flag", "type": "boolean" },
    { "name": "health_status", "type": "string", "note": "Healthy | Warning | Critical" },
    { "name": "data_quality", "type": "string", "note": "GOOD | PARTIAL | STALE" },
    { "name": "company_id", "type": "string" },
    { "name": "company_name", "type": "string" },
    { "name": "location_id", "type": "string" },
    { "name": "location_name", "type": "string" },
    { "name": "location_city", "type": "string" },
    { "name": "location_state", "type": "string" },
    { "name": "location_country", "type": "string" },
    { "name": "hvac_machine_id", "type": "string" },
    { "name": "component_id", "type": "string" },
    { "name": "component_type", "type": "string", "note": "Always 'evaporator'" },
    { "name": "batch_id", "type": "string" },
    { "name": "uploaded_by", "type": "string" },
    { "name": "source_file_name", "type": "string" },
    { "name": "circuit_id", "type": "object", "note": "Null for evaporators (only one per machine)" },
    { "name": "date", "type": "string", "note": "Partition key, format YYYY-MM-DD" }
  ]
}
