{
  "table": "stg_compressor",
  "layer": "staging",
  "partitionBy": ["date"],
  "columns": [
    { "name": "event_id", "type": "string", "key": "PK" },
    { "name": "timestamp", "type": "int64", "note": "Unix timestamp in milliseconds" },
    { "name": "circuit_id", "type": "string", "note": "Circuit A or B" },
    { "name": "compressor_status", "type": "string", "note": "ON | OFF" },
    { "name": "run_hours", "type": "string" },
    { "name": "start_stop_count", "type": "string" },
    { "name": "run_status", "type": "int64" },
    { "name": "suction_pressure_kpa", "type": "string" },
    { "name": "discharge_pressure_kpa", "type": "string" },
    { "name": "oil_pressure_kpa", "type": "string" },
    { "name": "suction_temperature_c", "type": "string" },
    { "name": "discharge_temperature_c", "type": "string" },
    { "name": "oil_temperature_c", "type": "string" },
    { "name": "motor_winding_temperature_c", "type": "string" },
    { "name": "voltage_v", "type": "string" },
    { "name": "current_a", "type": "string" },
    { "name": "power_consumption_kw", "type": "string" },
    { "name": "frequency_hz", "type": "string" },
    { "name": "power_factor", "type": "string" },
    { "name": "rpm", "type": "string" },
    { "name": "vibration_mm_s", "type": "string" },
    { "name": "bearing_temperature_c", "type": "string" },
    { "name": "eer", "type": "string" },
    { "name": "cop", "type": "string" },
    { "name": "health_active_fault_code", "type": "float64", "note": "Numeric fault code (e.g. 288). NaN if no fault." },
    { "name": "health_maintenance_flag", "type": "boolean" },
    { "name": "health_status", "type": "string", "note": "Healthy | Warning | Critical" },
    { "name": "data_quality", "type": "string", "note": "GOOD | PARTIAL | STALE" },
    { "name": "company_id", "type": "string" },
    { "name": "company_name", "type": "string" },
    { "name": "location_id", "type": "string" },
    { "name": "location_name", "type": "string" },
    { "name": "location_city", "type": "string" },
    { "name": "location_state", "type": "string" },
    { "name": "location_country", "type": "string" },
    { "name": "hvac_machine_id", "type": "string" },
    { "name": "component_id", "type": "string" },
    { "name": "component_type", "type": "string", "note": "Always 'compressor'" },
    { "name": "batch_id", "type": "string" },
    { "name": "uploaded_by", "type": "string" },
    { "name": "source_file_name", "type": "string" },
    { "name": "date", "type": "string", "note": "Partition key, format YYYY-MM-DD" }
  ]
}