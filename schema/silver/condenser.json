{
  "table": "silver_condenser_events",
  "layer": "silver",
  "partitionBy": ["event_date", "component_type"],
  "columns": [
    { "name": "event_id", "type": "string", "key": "PK (post-dedup)" },
    { "name": "event_timestamp", "type": "timestamp" },
    { "name": "event_date", "type": "date" },
    { "name": "company_key", "type": "bigint", "key": "FK -> dim_company" },
    { "name": "location_key", "type": "bigint", "key": "FK -> dim_location" },
    { "name": "controller_key", "type": "bigint", "key": "FK -> dim_controller" },
    { "name": "hvac_machine_key", "type": "bigint", "key": "FK -> dim_hvac_machine" },
    { "name": "component_key", "type": "bigint", "key": "FK -> dim_component" },
    { "name": "component_type", "type": "string", "note": "denormalized for partition pruning" },
    { "name": "data_quality", "type": "string" },
    { "name": "is_valid", "type": "boolean", "note": "finalized here; staging only flagged" },
    { "name": "health_status", "type": "string" },
    { "name": "fault_code_key", "type": "bigint", "key": "FK -> dim_fault_code, nullable" },
    { "name": "maintenance_flag", "type": "boolean" },
    { "name": "silver_loaded_at", "type": "timestamp" },

    { "name": "condenser_status", "type": "string" },
    { "name": "run_hours", "type": "double" },
    { "name": "condenser_pressure_kpa", "type": "double" },
    { "name": "pressure_drop_kpa", "type": "double" },
    { "name": "water_inlet_temperature_c", "type": "double" },
    { "name": "water_outlet_temperature_c", "type": "double" },
    { "name": "cooling_tower_water_temperature_c", "type": "double" },
    { "name": "ambient_air_temperature_c", "type": "double" },
    { "name": "water_flow_rate_gpm", "type": "double" },
    { "name": "water_valve_position_pct", "type": "double" },
    { "name": "fan_status", "type": "string" },
    { "name": "fan_speed_rpm", "type": "double" },
    { "name": "fan_current_a", "type": "double" },
    { "name": "fan_power_kw", "type": "double" },
    { "name": "voltage_v", "type": "double" },
    { "name": "frequency_hz", "type": "double" },
    { "name": "power_factor", "type": "double" },
    { "name": "power_consumption_kw", "type": "double" },
    { "name": "approach_temperature_c", "type": "double" },
    { "name": "heat_rejection_efficiency_pct", "type": "double" },
    { "name": "is_running", "type": "boolean", "derivedFrom": "condenser_status == 'ON'" },
    { "name": "is_fan_running", "type": "boolean", "derivedFrom": "fan_status == 'ON'" },
    { "name": "heat_rejection_kw", "type": "double", "derivedFrom": "water_flow_rate_gpm x (water_outlet_temperature_c - water_inlet_temperature_c) x constant" },
    { "name": "is_faulted", "type": "boolean", "derivedFrom": "fault_code_key is not null" }
  ]
}