{
  "table": "silver_evaporator_events",
  "layer": "silver",
  "partitionBy": ["event_date", "component_type"],
  "columns": [
    { "name": "event_id", "type": "string", "key": "PK (post-dedup)" },
    { "name": "event_timestamp", "type": "timestamp" },
    { "name": "event_date", "type": "date" },
    { "name": "company_key", "type": "bigint", "key": "FK -> dim_company" },
    { "name": "plant_key", "type": "bigint", "key": "FK -> dim_plant" },
    { "name": "controller_key", "type": "bigint", "key": "FK -> dim_controller" },
    { "name": "hvac_machine_key", "type": "bigint", "key": "FK -> dim_hvac_machine" },
    { "name": "component_key", "type": "bigint", "key": "FK -> dim_component" },
    { "name": "component_type", "type": "string", "note": "denormalized for partition pruning" },
    { "name": "data_quality", "type": "string" },
    { "name": "is_valid", "type": "boolean", "note": "finalized here; staging only flagged" },
    { "name": "health_status", "type": "string" },
    { "name": "fault_code_key", "type": "bigint", "key": "FK -> dim_fault_code, nullable" },
    { "name": "maintenance_flag", "type": "boolean" },
    { "name": "silver_loaded_at", "type": "timestamp" },
    
    { "name": "evaporator_status", "type": "string" },
    { "name": "run_hours", "type": "double" },
    { "name": "entering_chilled_water_temperature_c", "type": "double" },
    { "name": "leaving_chilled_water_temperature_c", "type": "double" },
    { "name": "temperature_difference_c", "type": "double" },
    { "name": "evaporator_pressure_kpa", "type": "double" },
    { "name": "water_flow_rate_gpm", "type": "double" },
    { "name": "flow_switch_status", "type": "string" },
    { "name": "lwt_setpoint_c", "type": "double" },
    { "name": "pump_control_mode", "type": "string" },
    { "name": "pump_relay_1_status", "type": "string" },
    { "name": "pump_relay_2_status", "type": "string" },
    { "name": "pump_power_consumption_kw", "type": "double" },
    { "name": "pump_current_a", "type": "double" },
    { "name": "pump_frequency_hz", "type": "double" },
    { "name": "cooling_capacity_tr", "type": "double" },
    { "name": "heat_transfer_efficiency_pct", "type": "double" },
    { "name": "is_pump_running", "type": "boolean", "derivedFrom": "pump_relay_1_status == 'ON' or pump_relay_2_status == 'ON'" },
    { "name": "cooling_load_kw", "type": "double", "derivedFrom": "water_flow_rate_gpm x temperature_difference_c x constant" },
    { "name": "setpoint_deviation_c", "type": "double", "derivedFrom": "leaving_chilled_water_temperature_c - lwt_setpoint_c" },
    { "name": "is_faulted", "type": "boolean", "derivedFrom": "fault_code_key is not null" }
  ]
}