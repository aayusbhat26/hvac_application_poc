{
  "table": "silver_expansion_valve_events",
  "layer": "silver",
  "partitionBy": ["event_date", "component_type"],
  "columns": [
    { "name": "event_id", "type": "string", "key": "PK (post-dedup)" },
    { "name": "event_timestamp", "type": "timestamp" },
    { "name": "event_date", "type": "date" },
    { "name": "company_key", "type": "bigint", "key": "FK -> dim_company" },
    { "name": "location_key", "type": "bigint", "key": "FK -> dim_location" },
    { "name": "controller_key", "type": "bigint", "key": "FK -> dim_controller" },
    { "name": "hvac_machine_key", "type": "bigint", "key": "FK -> dim_hvac_machine" },
    { "name": "component_key", "type": "bigint", "key": "FK -> dim_component" },
    { "name": "component_type", "type": "string", "note": "denormalized for partition pruning" },
    { "name": "data_quality", "type": "string" },
    { "name": "is_valid", "type": "boolean", "note": "finalized here; staging only flagged" },
    { "name": "health_status", "type": "string" },
    { "name": "fault_code_key", "type": "bigint", "key": "FK -> dim_fault_code, nullable" },
    { "name": "maintenance_flag", "type": "boolean" },
    { "name": "silver_loaded_at", "type": "timestamp" },
    
    { "name": "valve_status", "type": "string" },
    { "name": "run_hours", "type": "double" },
    { "name": "valve_opening_pct", "type": "double" },
    { "name": "valve_step_position", "type": "int" },
    { "name": "liquid_line_temperature_c", "type": "double" },
    { "name": "evaporator_outlet_temperature_c", "type": "double" },
    { "name": "superheat_c", "type": "double" },
    { "name": "subcooling_c", "type": "double" },
    { "name": "inlet_pressure_kpa", "type": "double" },
    { "name": "outlet_pressure_kpa", "type": "double" },
    { "name": "pressure_drop_kpa", "type": "double" },
    { "name": "refrigerant_flow_rate_kg_min", "type": "double" },
    { "name": "actuator_voltage_v", "type": "double" },
    { "name": "actuator_current_a", "type": "double" },
    { "name": "power_consumption_w", "type": "double" },
    { "name": "target_superheat_c", "type": "double" },
    { "name": "control_mode", "type": "string" },
    { "name": "response_time_ms", "type": "int" },
    { "name": "is_active", "type": "boolean", "derivedFrom": "valve_status == 'ACTIVE'" },
    { "name": "superheat_deviation_c", "type": "double", "derivedFrom": "superheat_c - target_superheat_c" },
    { "name": "is_faulted", "type": "boolean", "derivedFrom": "fault_code_key is not null" }
  ]
}