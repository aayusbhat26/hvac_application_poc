{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flat Raw Expansion Valve Telemetry Schema",
  "type": "object",
  "properties": {
    "ingestionMode": { "type": "string", "enum": ["REALTIME", "BATCH"] },
    "uploadedBy": { "type": "string" },
    "uploadTimestamp": { "type": "string", "format": "date-time" },
    "sourceFileName": { "type": "string" },
    "sourceSystem": { "type": "string" },
    "ingestionChannel": { "type": "string", "enum": ["KAFKA", "S3_UPLOAD", "API", "MANUAL"] },
    "rawPayload": {
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTimestamp": { "type": "string", "format": "date-time" },
        "dataQuality": { "type": "string", "enum": ["GOOD", "PARTIAL", "STALE"] },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "plantId": { "type": "string" },
        "plantName": { "type": "string" },
        "plantBuilding": { "type": "string" },
        "plantFloor": { "type": "string" },
        "plantZone": { "type": "string" },
        "plantLatitude": { "type": "number" },
        "plantLongitude": { "type": "number" },
        "controllerId": { "type": "string" },
        "controllerName": { "type": "string" },
        "hvacMachineId": { "type": "string" },
        "hvacMachineName": { "type": "string" },
        "componentId": { "type": "string" },
        "componentType": { "type": "string", "const": "EXPANSION_VALVE" },
        "componentName": { "type": "string" },
        "componentManufacturer": { "type": "string" },
        "componentModel": { "type": "string" },
        "componentSerialNumber": { "type": "string" },
        "componentInstallationDate": { "type": "string", "format": "date" },
        "healthStatus": { "type": "string" },
        "healthMaintenanceRequired": { "type": "boolean" },
        "healthLastMaintenanceDate": { "type": "string", "format": "date" },
        "healthActiveFaultCode": { "type": ["string", "null"] },
        "healthMaintenanceFlag": { "type": "boolean" },
        "valveStatus": { "type": "string" },
        "runHours": { "type": "number" },
        "valveOpeningPct": { "type": "number" },
        "valveStepPosition": { "type": "integer" },
        "liquidLineTemperatureC": { "type": "number" },
        "evaporatorOutletTemperatureC": { "type": "number" },
        "superheatC": { "type": "number" },
        "subcoolingC": { "type": "number" },
        "inletPressureKpa": { "type": "number" },
        "outletPressureKpa": { "type": "number" },
        "pressureDropKpa": { "type": "number" },
        "refrigerantFlowRateKgMin": { "type": "number" },
        "actuatorVoltageV": { "type": "number" },
        "actuatorCurrentA": { "type": "number" },
        "powerConsumptionW": { "type": "number" },
        "targetSuperheatC": { "type": "number" },
        "controlMode": { "type": "string" },
        "responseTimeMs": { "type": "integer" }
      },
      "required": ["eventId", "eventTimestamp", "companyId", "plantId", "controllerId", "hvacMachineId", "componentId", "componentType"]
    }
  },
  "required": ["ingestionMode", "uploadedBy", "uploadTimestamp", "sourceFileName", "sourceSystem", "ingestionChannel", "rawPayload"]
}